{
  "entities": {
    "User": {
      "title": "User",
      "description": "Unified user profile for customers and administrators",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "displayName": { "type": "string" },
        "phone": { "type": "string" },
        "countryCode": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "customer"] },
        "adminRole": { "type": "string", "description": "Specific admin role if role is admin" },
        "isAdmin": { "type": "boolean" },
        "permissions": { "type": "array", "items": { "type": "string" } },
        "isActive": { "type": "boolean" },
        "isBlocked": { "type": "boolean" },
        "walletBalance": { "type": "number" },
        "notes": { "type": "array" },
        "lastLogin": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "[DEPRECATED] Use User entity with role='admin' instead",
      "type": "object",
      "properties": {
        "id": { "type": "string" }
      }
    },
    "Product": {
      "title": "Product",
      "description": "Inventory product items",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "stockCount": { "type": "number" },
        "category": { "type": "string" },
        "image": { "type": "string" },
        "description": { "type": "string" },
        "inStock": { "type": "boolean" }
      },
      "required": ["name", "price", "stockCount"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "subtotal": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "processing", "shipped", "delivered", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "items", "total", "status"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Discount voucher",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "discount": { "type": "number" },
        "type": { "type": "string" },
        "expiryDate": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["code", "discount"]
    },
    "Settings": {
      "title": "Settings",
      "description": "System configuration documents",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "data": { "type": "object" }
      }
    },
    "Counter": {
      "title": "Counter",
      "description": "Global atomic sequence counter",
      "type": "object",
      "properties": {
        "orderCounter": { "type": "number", "description": "The sequential index for orders" }
      },
      "required": ["orderCounter"]
    },
    "UserNotification": {
      "title": "UserNotification",
      "description": "History of notifications sent to a specific user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "image": { "type": "string" },
        "url": { "type": "string" },
        "type": { "type": "string" },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "body", "createdAt"]
    },
    "Passkey": {
      "title": "Passkey",
      "description": "WebAuthn credential metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "credentialID": { "type": "string" },
        "credentialPublicKey": { "type": "string" },
        "counter": { "type": "number" },
        "transports": { "type": "array" }
      },
      "required": ["uid", "credentialID", "credentialPublicKey"]
    },
    "Review": {
      "title": "Review",
      "description": "Product review and rating from a customer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "rating": { "type": "number", "minimum": 1, "maximum": 5 },
        "comment": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "userId", "rating", "comment", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Core user accounts"
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": "UserNotification",
      "description": "Personal notification inbox"
    },
    "/admin_users/{adminId}": {
      "schema": "AdminUser",
      "description": "Staff and staff permissions"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Store inventory"
    },
    "/products/{productId}/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Customer feedback for a specific product"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer transactions"
    },
    "/coupons/{couponId}": {
      "schema": "Coupon",
      "description": "Promotional discounts"
    },
    "/settings/counters": {
      "schema": "Counter",
      "description": "Global order ID counter"
    },
    "/settings/{settingsId}": {
      "schema": "Settings",
      "description": "Site-wide configuration"
    },
    "/activityLogs/{logId}": {
      "schema": { "type": "object" },
      "description": "Administrative activity tracking"
    },
    "/passkeys/{passkeyId}": {
      "schema": "Passkey",
      "description": "User biometric authentication credentials"
    }
  }
}

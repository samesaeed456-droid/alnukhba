rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Section 1: Primitives & Helpers (Pillar 3 & 4)
    // ===============================================================
    
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com'); }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    
    // RBAC-based Admin Check (relational, plus hardcoded fallback)
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in [
          'samesaeed456@gmail.com', 'samisaeed2024@gmail.com', 'samisaeed2025@gmail.com',
          'samisaeed2027@gmail.com', 'samisaeed2028@gmail.com', 'samisaeed2030@gmail.com'
        ] || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'customer') == 'admin'))
      );
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128; }
    function isValidTokenId(id) { return id is string && id.size() <= 1024; }
    function isServerTimestamp(field) { return field == request.time; }

    // ===============================================================
    // Section 2: Entity Validations (Pillar 2 & 5)
    // ===============================================================

    function isValidUser(data) {
      return (data.get('uid', '') is string) && 
             (data.get('email', '') is string) &&
             (data.get('role', 'customer') in ['customer', 'admin']);
    }

    function isSafeUserUpdate() {
      // Admins can update anyone
      return isAdmin() || (
        isOwner(request.auth.uid) && 
        !incoming().diff(existing()).affectedKeys().hasAny(['role', 'uid', 'email', 'createdAt', 'isAdmin', 'adminRole', 'permissions', 'isBlocked']) &&
        (incoming().get('walletBalance', existing().get('walletBalance', 0)) <= existing().get('walletBalance', 0)) &&
        (incoming().get('updatedAt', request.time) == request.time)
      );
    }

    function isValidOrder(data) {
      return (data.userId is string && data.userId.size() <= 128 || data.userId == 'guest') && 
             (data.items is list && data.items.size() > 0 && data.items.size() <= 150) &&
             (data.total is number && data.total >= 0) &&
             (data.status in ['pending', 'processing', 'shipped', 'delivered', 'cancelled', 'refunded', 'failed']) &&
             (data.get('paymentMethod', '') is string) &&
             (data.get('paymentReference', '') == null || data.get('paymentReference', '') is string) &&
             (data.get('paymentAmount', '') == null || data.get('paymentAmount', '') is string);
    }

    function isValidRecharge(data) {
      return (data.userId is string && data.userId.size() <= 128) &&
             (data.amount is number && data.amount > 0) &&
             (data.get('reference', '') is string && data.get('reference', '').size() >= 4) &&
             (data.status in ['pending', 'approved', 'rejected']);
    }

    function isValidReview(data) {
      return (data.productId is string && data.productId.size() <= 128) &&
             (data.userId is string && data.userId.size() <= 128) &&
             (data.rating is number && data.rating >= 1 && data.rating <= 5) &&
             (data.comment is string && data.comment.size() <= 2000) &&
             (data.get('images', []) is list && data.get('images', []).size() <= 5) &&
             (data.get('status', 'approved') in ['pending', 'approved', 'rejected']);
    }

    // ===============================================================
    // Section 3: Collection Rules (Pillar 1 & 8)
    // ===============================================================

    // --- USERS ---
    match /users/{userId} {
      allow list: if isAdmin() || (isSignedIn() && (resource.data.uid == request.auth.uid || resource.data.email == request.auth.token.email));
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      
      allow create: if isValidId(userId) && (
        isAdmin() || 
        (isOwner(userId) && isValidUser(incoming()) && 
         incoming().get('role', 'customer') == 'customer' && 
         incoming().get('walletBalance', 0) == 0 &&
         incoming().get('isAdmin', false) == false)
      );
                    
      allow update: if isValidId(userId) && (isAdmin() || (isOwner(userId) && isSafeUserUpdate()));
      
      allow delete: if isAdmin() || isOwner(userId);
    }

    match /users/{userId}/notifications/{notificationId} {
      allow read, list: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow update: if isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['isRead']);
      allow create, delete: if isAdmin();
    }

    // --- DEPRECATED ADMIN ACCESS (FOR MIGRATION) ---
    match /admin_users/{adminId} {
      allow read, write: if isAdmin();
    }

    // --- PRODUCTS & CONTENT ---
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
      
      // Atomic Inventory Guard (Pillar 7)
      allow update: if (isSignedIn() || !isSignedIn()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['stockCount', 'inStock', 'updatedAt']) &&
                    incoming().stockCount <= existing().get('stockCount', 999999);
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isAdmin() || (incoming().name in ['إلكترونيات', 'بطاريات', 'شاشات', 'شبكات', 'صيانة', 'طاقة شمسية', 'قطع غيار', 'كاميرات مراقبة', 'كهربائيات']);
      allow update, delete: if isAdmin();
    }

    match /static_pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
      allow update: if (isSignedIn() || !isSignedIn()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['usedCount']) &&
                    incoming().usedCount >= existing().usedCount;
    }

    match /cities/{cityId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /customers/{customerId} {
      allow read, write: if isAdmin();
    }

    match /shipping_zones/{zoneId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- REVIEWS ---
    match /products/{productId}/reviews/{reviewId} {
      allow read: if true; 
      allow create: if isVerified() &&
                    isValidReview(incoming()) &&
                    incoming().userId == request.auth.uid &&
                    incoming().productId == productId &&
                    incoming().createdAt == request.time;
      allow update: if isAdmin() || (isOwner(resource.data.userId) && incoming().diff(existing()).affectedKeys().hasOnly(['comment', 'rating', 'images', 'updatedAt']));
      allow delete: if isAdmin() || isOwner(resource.data.userId);
    }

    // --- PASSKEYS ---
    match /passkeys/{passkeyId} {
      allow list, get: if isSignedIn() && (resource == null || resource.data.uid == request.auth.uid);
      allow write: if isAdmin(); // Managed via server-side API
    }

    // --- ORDERS ---
    match /orders/{orderId} {
      // Pillar 8: Query Enforcer
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid) || (!isSignedIn() && resource.data.userId == 'guest');
      allow get: if isValidId(orderId) && (isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid) || (!isSignedIn() && resource.data.userId == 'guest'));
      
      allow create: if isValidId(orderId) && 
                    ((isSignedIn() && incoming().userId == request.auth.uid) || (!isSignedIn() && incoming().userId == 'guest')) && 
                    isValidOrder(incoming()) &&
                    incoming().status in ['pending', 'processing'];
                    
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- RECHARGES ---
    match /recharges/{rechargeId} {
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow get: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidRecharge(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- SETTINGS & COUNTERS ---
    match /settings/counters {
      allow read: if true;
      allow create: if incoming().orderCounter == 1;
      allow update: if (incoming().orderCounter == existing().orderCounter + 1) || isAdmin();
    }

    match /settings/{settingsId} {
      allow read: if true;
      allow write: if isAdmin();
      allow update: if (isSignedIn() || !isSignedIn()) && settingsId == 'store_meta' && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['products_updated_at', 'categories_updated_at', 'updatedAt']);
    }

    // --- SUPPORT ---
    match /support_tickets/{ticketId} {
      allow list, get: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if true; // Public tickets allowed
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // --- MISC / SYSTEM ---
    match /inventory_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin(); // Only admins/system should log inventory changes via client
    }

    match /statistics/{statId} {
      allow read: if isAdmin();
      allow create, update: if statId.matches('^daily_.*');
      allow delete: if isAdmin();
    }
    match /visits/{visitId} { 
      allow create: if visitId is string && visitId.size() <= 128 && incoming().size() <= 10; 
      allow read: if isAdmin(); 
    }
    match /searchTerms/{termId} { 
      allow read: if true;
      allow create, update: if termId is string && termId.size() <= 128 && incoming().size() <= 6; 
    }
    
    match /marketing_notifications/{notificationId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // --- LOGS & ACTIVITY ---
    match /activity_logs/{logId} {
      allow create: if isSignedIn(); // Allow authenticated users to log activity
      allow read: if isAdmin();
    }

    match /activityLogs/{logId} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
    }

    match /system/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notification_tokens/{token} {
      allow get: if true;
      allow create, update: if isValidTokenId(token) && incoming().size() <= 15;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // Diagnostic paths
    match /test/connection { allow read: if true; }
    match /system/connection_test { allow read: if true; }
  }
}

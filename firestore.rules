rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Section 1: Primitives & Helpers (Pillar 3 & 4)
    // ===============================================================
    
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com'); }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    
    // Hardened Admin Check (Relational + Token based)
    function isAdmin() {
      let userEmail = request.auth.token.get('email', '');
      return isSignedIn() && (
        userEmail in ["samesaeed456@gmail.com", "samisaeed2027@gmail.com", "967776668370@elite-store.local"] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true) ||
        exists(/databases/$(database)/documents/admin_users/$(request.auth.uid))
      );
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isServerTimestamp(field) { return field == request.time; }

    // ===============================================================
    // Section 2: Entity Validations (Pillar 2 & 5)
    // ===============================================================

    function isValidUser(data) {
      return (data.get('uid', '') is string && data.get('uid', '').size() <= 128) && 
             (data.get('email', '') is string && data.get('email', '').size() <= 200) &&
             (data.get('role', 'user') in ['user', 'admin']) &&
             (!('walletBalance' in data) || (data.walletBalance is number && data.walletBalance >= 0)) &&
             (!('name' in data) || (data.name is string && data.name.size() <= 200)) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 200)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000)) &&
             (!('fcmTokens' in data) || (data.fcmTokens is list && data.fcmTokens.size() <= 10)) &&
             (!('notificationsEnabled' in data) || data.notificationsEnabled is bool) &&
             (!('isAdmin' in data) || data.isAdmin is bool) &&
             (!('adminRole' in data) || data.adminRole is string) &&
             (!('adminName' in data) || data.adminName is string) &&
             (!('status' in data) || data.status is string) &&
             (!('createdAt' in data) || data.createdAt is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isSafeUserUpdate() {
      // Logic: Allow admins to change everything. Allow users to change only non-critical fields.
      let affected = incoming().diff(existing()).affectedKeys();
      return isAdmin() || (
        isOwner(request.auth.uid) && 
        !affected.hasAny(['role', 'walletBalance', 'uid', 'email', 'createdAt', 'isAdmin', 'adminRole']) &&
        incoming().get('updatedAt', request.time) == request.time
      );
    }

    function isValidOrder(data) {
      return (data.userId is string && data.userId.size() <= 128) && 
             (data.items is list && data.items.size() > 0 && data.items.size() <= 50) &&
             (data.total is number && data.total >= 0) &&
             (data.status in ['pending', 'processing', 'shipped', 'delivered', 'cancelled']);
    }

    // ===============================================================
    // Section 3: Collection Rules (Pillar 1 & 8)
    // ===============================================================

    // --- USERS ---
    match /users/{userId} {
      allow list: if isAdmin();
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      
      allow create: if isValidId(userId) && (
        isAdmin() || 
        (isOwner(userId) && isValidUser(incoming()) && 
         incoming().get('role', 'user') == 'user' && 
         incoming().get('walletBalance', 0) == 0)
      );
                    
      allow update: if isValidId(userId) && (isAdmin() || isOwner(userId)) && 
                    isValidUser(incoming()) && isSafeUserUpdate();
      
      allow delete: if isAdmin();
    }

    match /users/{userId}/notifications/{notificationId} {
      allow read, list: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow update: if isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['isRead']);
      allow create, delete: if isAdmin();
    }

    // --- ADMIN ACCESS ---
    match /admin_users/{adminId} {
      allow list: if isAdmin() || (isSignedIn() && request.query.limit <= 1);
      allow get: if isValidId(adminId) && isSignedIn() && (isOwner(adminId) || isAdmin() || (resource.data.email == request.auth.token.get('email', '')));
      allow create, update, delete: if isAdmin();
    }

    // --- PRODUCTS & CONTENT ---
    match /products/{productId} {
      allow read: if isValidId(productId);
      allow write: if isAdmin();
      
      // Atomic Inventory Guard (Pillar 7)
      allow update: if (isSignedIn() || !isSignedIn()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['stockCount']) &&
                    incoming().stockCount <= existing().stockCount;
    }

    match /categories/{categoryId} {
      allow read: if isValidId(categoryId);
      allow write: if isAdmin();
    }

    match /blog_posts/{postId} {
      allow read: if isValidId(postId);
      allow write: if isAdmin();
    }

    match /static_pages/{pageId} {
      allow read: if isValidId(pageId);
      allow write: if isAdmin();
    }

    // --- ORDERS ---
    match /orders/{orderId} {
      // Pillar 8: Query Enforcer
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow get: if isValidId(orderId) && (isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid) || (!isSignedIn() && resource.data.userId == 'guest'));
      
      allow create: if isValidId(orderId) && 
                    ((isSignedIn() && incoming().userId == request.auth.uid) || (!isSignedIn() && incoming().userId == 'guest')) && 
                    isValidOrder(incoming()) &&
                    incoming().status in ['pending', 'processing'];
                    
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- SETTINGS & COUNTERS ---
    match /settings/counters {
      allow read: if true;
      allow create: if incoming().orderCounter == 1;
      allow update: if (incoming().orderCounter == existing().orderCounter + 1) || isAdmin();
    }

    match /settings/{settingsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- SUPPORT ---
    match /support_tickets/{ticketId} {
      allow list, get: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if true; // Public tickets allowed
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // --- MISC / SYSTEM ---
    match /activity_logs/{logId} {
      allow read: if isAdmin();
      allow create: if true; 
    }

    match /inventory_logs/{logId} {
      allow read: if isAdmin();
      allow create: if true;
    }

    match /visits/{visitId} { allow create: if true; allow read: if isAdmin(); }
    match /searchTerms/{termId} { allow create, update: if true; allow read: if isAdmin(); }
    match /abandonedCarts/{cartId} { allow create, update, delete: if true; allow read: if isAdmin(); }
    
    match /marketing_notifications/{notificationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notification_tokens/{token} {
      allow get, create, update: if true;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // Diagnostic paths
    match /test/connection { allow read: if true; }
    match /system/connection_test { allow read: if true; }
  }
}

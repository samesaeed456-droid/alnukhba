rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Section 1: Primitives & Helpers (Pillar 3 & 4)
    // ===============================================================
    
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com'); }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    
    // Hardened Admin Check (Fast & Relational)
    function isAdmin() {
      // Check for Admin from BOTH App Instances (Standard and Dedicated Admin App)
      // Standard app uses standard request.auth. Dedicated admin-app uses the same backend but distinct instance.
      // Firebase Security Rules evaluate against the UID and token of the request.auth object regardless of instance name on client.
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == "samesaeed456@gmail.com") || 
        (request.auth.token.email != null && request.auth.token.email.lower() == "samisaeed2027@gmail.com") || 
        (request.auth.token.email != null && request.auth.token.email.lower() == "samisaeed2025@gmail.com") ||
        (request.auth.token.email != null && request.auth.token.email.lower() == "967776668370@elite-store.local") ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'customer') == 'admin'))
      );
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isServerTimestamp(field) { return field == request.time; }

    // ===============================================================
    // Section 2: Entity Validations (Pillar 2 & 5)
    // ===============================================================

    function isValidUser(data) {
      return (data.get('uid', '') is string) && 
             (data.get('email', '') is string) &&
             (data.get('role', 'customer') in ['customer', 'admin']);
    }

    function isSafeUserUpdate() {
      // Admins can update anyone
      return isAdmin() || (
        isOwner(request.auth.uid) && 
        !incoming().diff(existing()).affectedKeys().hasAny(['role', 'walletBalance', 'uid', 'email', 'createdAt', 'isAdmin', 'adminRole', 'permissions', 'isBlocked']) &&
        incoming().get('updatedAt', request.time) == request.time
      );
    }

    function isValidOrder(data) {
      return (data.userId is string && data.userId.size() <= 128) && 
             (data.items is list && data.items.size() > 0 && data.items.size() <= 50) &&
             (data.total is number && data.total >= 0) &&
             (data.status in ['pending', 'processing', 'shipped', 'delivered', 'cancelled']);
    }

    // ===============================================================
    // Section 3: Collection Rules (Pillar 1 & 8)
    // ===============================================================

    // --- USERS ---
    match /users/{userId} {
      allow list: if isAdmin();
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      
      allow create: if isValidId(userId) && (
        isAdmin() || 
        (isOwner(userId) && isValidUser(incoming()) && 
         incoming().get('role', 'customer') == 'customer' && 
         incoming().get('walletBalance', 0) == 0 &&
         incoming().get('isAdmin', false) == false)
      );
                    
      allow update: if isValidId(userId) && (isAdmin() || isOwner(userId)) && 
                    isValidUser(incoming()) && isSafeUserUpdate();
      
      allow delete: if isAdmin();
    }

    match /users/{userId}/notifications/{notificationId} {
      allow read, list: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow update: if isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['isRead']);
      allow create, delete: if isAdmin();
    }

    // --- DEPRECATED ADMIN ACCESS (FOR MIGRATION) ---
    match /admin_users/{adminId} {
      allow read, write: if isAdmin();
    }

    // --- PRODUCTS & CONTENT ---
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
      
      // Atomic Inventory Guard (Pillar 7)
      allow update: if (isSignedIn() || !isSignedIn()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['stockCount']) &&
                    incoming().stockCount <= existing().stockCount;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blog_posts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /static_pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /shipping_zones/{zoneId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- ORDERS ---
    match /orders/{orderId} {
      // Pillar 8: Query Enforcer
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow get: if isValidId(orderId) && (isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid) || (!isSignedIn() && resource.data.userId == 'guest'));
      
      allow create: if isValidId(orderId) && 
                    ((isSignedIn() && incoming().userId == request.auth.uid) || (!isSignedIn() && incoming().userId == 'guest')) && 
                    isValidOrder(incoming()) &&
                    incoming().status in ['pending', 'processing'];
                    
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- SETTINGS & COUNTERS ---
    match /settings/counters {
      allow read: if true;
      allow create: if incoming().orderCounter == 1;
      allow update: if (incoming().orderCounter == existing().orderCounter + 1) || isAdmin();
    }

    match /settings/{settingsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- SUPPORT ---
    match /support_tickets/{ticketId} {
      allow list, get: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if true; // Public tickets allowed
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // --- MISC / SYSTEM ---
    match /activity_logs/{logId} {
      allow read: if isAdmin();
      allow create: if true; 
    }

    match /inventory_logs/{logId} {
      allow read: if isAdmin();
      allow create: if true;
    }

    match /visits/{visitId} { allow create: if true; allow read: if isAdmin(); }
    match /searchTerms/{termId} { allow create, update: if true; allow read: if isAdmin(); }
    match /abandonedCarts/{cartId} { allow create, update, delete: if true; allow read: if isAdmin(); }
    
    match /marketing_notifications/{notificationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notification_tokens/{token} {
      allow get, create, update: if true;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // Diagnostic paths
    match /test/connection { allow read: if true; }
    match /system/connection_test { allow read: if true; }
  }
}
